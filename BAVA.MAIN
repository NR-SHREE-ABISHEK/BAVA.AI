import datetime
import os
import pyttsx3
import speech_recognition as sr

engine = pyttsx3.init()
def speak(text):
    print("bava:", text)
    engine.say(text)
    engine.runAndWait()
def listen():
    r = sr.Recognizer()
    with sr.Microphone() as source:
        print("Listening...")
        audio = r.listen(source)
    try:
      command = r.recognize_google(audio)
      print("You:", command)
      return command.lower()
    except:
       speak("Sorry, enakku puriyala")
       return ""
speak("bava Activated")
while True:
      mode = input("\nType 'voice' for voice or type your command: ").lower()
    if mode == "voice":
        command = listen()
    else:
        command = mode
    if "time" in command:
        now = datetime.datetime.now()
        current_time = now.strftime("%I:%M %p")
        speak("Current time is " + current_time)
    elif "who are you" in command:
        speak("I am an AI assistant")
    elif "say about my self" in command:
        speak("You are a young developer aiming to create AI and your name is Abishek")
    elif "open spotify" in command:
        speak("Vaa pulla vaa")
        os.system("start https://open.spotify.com/")
    elif "open my github" in command:
        speak("Nee massu thala, wait pannu thala")
        os.system("start https://github.com/HR-SHREE-ABISHEK")
    elif "open instagram" in command or "open insta" in command:
        speak("Opening Instagram")
        os.system("start https://www.instagram.com/")
    elif "open a2d" in command or "a2d youtube" in command:
        speak("Opening A2D")
        os.system("start https://www.youtube.com/@a2dchannel")
    elif "youtube" in command:
        speak("Wait pannu da pulla")
        os.system("start https://www.youtube.com/")
    elif "open google" in command:
        speak("Opening Google")
        os.system("start https://www.google.com/")
    elif "open gmail" in command:
        speak("Opening Gmail")
        os.system("start https://mail.google.com/")
    elif "open whatsapp" in command:
        speak("Opening WhatsApp")
        os.system("start https://web.whatsapp.com/")
    elif "open chatgpt" in command:
        speak("Opening ChatGPT")
        os.system("start https://chatgpt.com/")
    elif "open github" in command:
        speak("Opening GitHub")
        os.system("start https://github.com/")
    elif "open maps" in command:
        speak("Opening Maps")
        os.system("start https://maps.google.com/")
    elif "bye" in command or "exit" in command:
        speak("Goodbye boss")
        break
    else:
        speak("Google la search panren")
        search_url = (
            "https://www.google.com/search?q="
            + command.replace(" ", "+")
        )
        os.system("start " + search_url)