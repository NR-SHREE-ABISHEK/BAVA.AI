import datetime
import os
import pyttsx3
import speech_recognition as sr

engine = pyttsx3.init("sapi5")
engine.setProperty("rate",175)
voices=engine.getProperty("voices")
if voices:
    engine.setProperty("voices",voices[1].id)

def speak(text):
    print("BAVA:", text)
    engine.say(text)
    engine.runAndWait()
def listen():
    r = sr.Recognizer()
    with sr.Microphone() as source:
        print("Listening...")
        audio = r.listen(source)
    try:
      command = r.recognize_google(audio)
      print("You:", command)
      return command.lower()
    except:
       speak("Sorry, enakku puriyala")
       return ""
speak("BAVA Activated")
while True:
    mode = input("\nType 'voice' for voice or type your command: ").lower()
    if mode == "voice":
        command = listen()
    else:
        command = mode
    if "time" in command:
        now = datetime.datetime.now()
        current_time = now.strftime("%I:%M %p")
        speak("Current time is " + current_time)
    elif "who are you" in command:
        speak("I am an AI assistant")
    elif "say about my self" in command:
        speak("You are a young developer aiming to create AI and your name is Abishek")
