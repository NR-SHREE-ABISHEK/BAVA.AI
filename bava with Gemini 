
import datetime
import os
import webbrowser
import urllib.parse
import pyttsx3
import speech_recognition as sr
from google import genai

API_KEY = os.getenv("GEMINI_API_KEY")

if API_KEY:
    client = genai.Client(api_key=API_KEY)
else:
    client = None

MODEL = "gemini-flash-latest"

engine = pyttsx3.init("sapi5")
engine.setProperty("rate", 175)

voices = engine.getProperty("voices")

if voices:
    voice_index = 1 if len(voices) > 1 else 0
    engine.setProperty("voice", voices[voice_index].id)


def speak(text):
    print("BAVA:", text)
    engine.say(text)
    engine.runAndWait()


def listen():
    r = sr.Recognizer()

    with sr.Microphone() as source:
        print("Listening...")
        audio = r.listen(source)

    try:
        command = r.recognize_google(audio)
        print("You:", command)
        return command.lower()

    except Exception:
        speak("Sorry, enakku puriyala")
        return ""


def ask_gemini(question):

    if client is None:
        speak("Gemini API key is missing")
        return

    try:
        speak("Gemini AI is thinking")

        response = client.models.generate_content(
            model=MODEL,
            contents=(
                "You are BAVA, a friendly AI assistant. "
                "Your creator is Abishek. "
                "Give clear, simple and helpful answers. "
                "For programming questions, explain step by step.\n\n"
                "User: " + question
            )
        )

        answer = response.text

        if answer:
            speak(answer)
        else:
            speak("I couldn't generate an answer")

    except Exception as e:
        print("Gemini Error:", e)
        speak("Sorry, Gemini is not responding right now")


speak("BAVA Activated")

